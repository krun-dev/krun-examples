{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "postgres-todo",
  "main": "src/index.js",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "hyperdrive": [
    {
      "binding": "DB",
      // Replace this example ID with your krun Hyperdrive configuration ID before deploying.
      "id": "00000000000000000000000000000000",
    },
  ],
}
